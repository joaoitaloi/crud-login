PORT=3000
APP_URL=http://localhost:3000

# MySQL Workbench local normalmente usa a porta 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=usuarios
DB_USER=seu_usuario_mysql
DB_PASS=sua_senha_mysql

# Troque por uma chave aleatória com pelo menos 32 caracteres.
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-com-mais-de-32-caracteres
JWT_EXPIRES_IN=1h

# Para teste local, o link aparece no terminal. Para envio real, use smtp.
RESET_EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
